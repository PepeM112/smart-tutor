{
  "name": "frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx @hey-api/openapi-ts && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:style": "stylelint \"src/**/*.{css}\" --allow-empty-input",
    "format": "eslint . --ext .ts,.tsx --fix && stylelint \"src/**/*.{css}\" --fix --allow-empty-input && prettier \"**/*.{css,ts,tsx,js,json,yaml,yml}\" --write --ignore-path .prettierignore",
    "format:check": "eslint . --ext .ts,.tsx && stylelint \"src/**/*.{css}\" --allow-empty-input && prettier \"**/*.{css,ts,tsx,js,json,yaml,yml}\" --check --ignore-path .prettierignore",
    "format:branch": "f() { FILES=$(git diff --name-only --diff-filter=ACMR $(git merge-base HEAD ${BASE_BRANCH:-dev}) | grep '^frontend/' | sed 's|^frontend/||'); TSX_FILES=$(echo \"$FILES\" | grep -E '\\.(ts|tsx)$'); CSS_FILES=$(echo \"$FILES\" | grep -E '\\.css$'); if [ -n \"$TSX_FILES\" ]; then eslint $TSX_FILES --fix; fi; if [ -n \"$CSS_FILES\" ]; then stylelint $CSS_FILES --fix --allow-empty-input; fi; if [ -n \"$FILES\" ]; then prettier $FILES --write --ignore-unknown; fi; }; f",
    "format:branch:check": "f() { FILES=$(git diff --name-only --diff-filter=ACMR $(git merge-base HEAD ${BASE_BRANCH:-dev}) | grep '^frontend/' | sed 's|^frontend/||'); TSX_FILES=$(echo \"$FILES\" | grep -E '\\.(ts|tsx)$'); CSS_FILES=$(echo \"$FILES\" | grep -E '\\.css$'); if [ -n \"$TSX_FILES\" ]; then eslint $TSX_FILES; fi && if [ -n \"$CSS_FILES\" ]; then stylelint $CSS_FILES --allow-empty-input; fi && if [ -n \"$FILES\" ]; then prettier $FILES --check --ignore-unknown; fi; }; f",
    "gen-client": "openapi-ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.94.5",
    "@next/eslint-plugin-next": "^16.2.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.96.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.57.2"
  }
}
