# SmartTutor — Backend Environment Variables
# Copy this file to .env and fill in the values.
#
# For demo mode (make demo), the defaults below work out of the box
# with the local PostgreSQL container — no external services needed.

# === Required ===

# Database — points to the local demo PostgreSQL by default.
# Replace with a Neon.tech connection string for production.
DATABASE_URL=postgresql://smarttutor:smarttutor@db:5432/smarttutor

# JWT signing secret — any random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=demo-jwt-secret-change-in-production

# Fernet key for encrypting per-user API keys at rest.
# Generate one with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gOhDNNW1ZxMj7s5xBxUC-WeUitVRMR2swOgNcxXkH58=

# === AI (Optional) ===
# Without these, the app runs normally but AI features show a
# "configure your API key in Settings" message. Users can add
# their own keys in the Settings page at any time.

# System-level OpenAI key for RAG embeddings (semantic search).
# Leave empty to disable note indexing and semantic search.
# SYSTEM_OPENAI_API_KEY=sk-...

# Per-user AI keys can also be set here for convenience,
# but the recommended flow is to configure them in the UI (Settings page).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
